{
  "name": "claude-session-manager",
  "version": "0.1.0",
  "description": "Manage Claude Code sessions: browse, search, resume, delete, backup, and analyze",
  "license": "MIT",
  "type": "module",
  "bin": {
    "csm": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/e2e-verify.mjs",
    "lint": "eslint src tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fuse.js": "^7.0.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.1.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/tar": "^6.1.0",
    "eslint": "^10.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.0.0"
  }
}
